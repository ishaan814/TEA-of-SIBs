def run_sustainability(
    # Per-cell masses from upstream
    c_AM_mass_g, a_AM_mass_g,
    c_carbon_g, a_carbon_g,
    c_binder_g, a_binder_g,
    c_foil_area_m2, a_foil_area_m2,
    sep_area_m2, elec_mass_g,
    container_mass_g, cell_mass_g,
    # Foil geometry
    a_foil_thick_um,
    # Pack scale
    total_cells, pack_useable_energy_kWh,
    # Cu/Al comparison prices
    p_al_kg, p_cu_kg,
    # CO2 intensity factors (kgCO2/kg)
    co2_cathode_am, co2_anode_am, co2_al_foil,
    co2_separator, co2_electrolyte, co2_carbon, co2_pvdf):

    AL_DENSITY = 2.70
    CU_DENSITY = 8.96

    # 1. Material intensity per kWh (kg material / kWh useable)
    def intensity(mass_g_per_cell):
        return (mass_g_per_cell * total_cells / 1000) / pack_useable_energy_kWh

    int_cathode_am  = intensity(c_AM_mass_g)
    int_anode_am    = intensity(a_AM_mass_g)
    int_carbon      = intensity(c_carbon_g + a_carbon_g)
    int_binder      = intensity(c_binder_g + a_binder_g)
    int_electrolyte = intensity(elec_mass_g)
    int_cell_total  = intensity(cell_mass_g)

    # 2. Al vs Cu foil comparison
    # Al anode foil actual mass (g/cell)
    al_anode_g = a_foil_area_m2 * 10000 * (a_foil_thick_um / 10000) * AL_DENSITY
    # Cu equivalent - same geometry, Cu density
    cu_equiv_g = a_foil_area_m2 * 10000 * (a_foil_thick_um / 10000) * CU_DENSITY

    al_pack_kg = al_anode_g * total_cells / 1000
    cu_pack_kg = cu_equiv_g * total_cells / 1000
    mass_saving_kg = cu_pack_kg - al_pack_kg
    cost_saving_usd = cu_pack_kg * p_cu_kg - al_pack_kg * p_al_kg
    cu_saving_per_kwh = cost_saving_usd / pack_useable_energy_kWh
    mass_saving_pct = (mass_saving_kg / cu_pack_kg) * 100

    # 3. CO2 intensity (kgCO2/kWh) - indicative
    al_foil_mass_g = (c_foil_area_m2 + a_foil_area_m2) * 10000 * (a_foil_thick_um / 10000) * AL_DENSITY
    sep_mass_g = sep_area_m2 * 10000 * 0.002 * 0.92  # approx from 20um PE

    co2_per_cell = (
        c_AM_mass_g    / 1000 * co2_cathode_am  +
        a_AM_mass_g    / 1000 * co2_anode_am    +
        al_foil_mass_g / 1000 * co2_al_foil     +
        sep_mass_g     / 1000 * co2_separator   +
        elec_mass_g    / 1000 * co2_electrolyte +
        (c_carbon_g + a_carbon_g) / 1000 * co2_carbon +
        c_binder_g     / 1000 * co2_pvdf
    )
    co2_per_kwh = (co2_per_cell * total_cells) / pack_useable_energy_kWh

    return {
        "int_cathode_am":    int_cathode_am,
        "int_anode_am":      int_anode_am,
        "int_carbon":        int_carbon,
        "int_binder":        int_binder,
        "int_electrolyte":   int_electrolyte,
        "int_cell_total":    int_cell_total,
        "al_pack_kg":        al_pack_kg,
        "cu_pack_kg":        cu_pack_kg,
        "mass_saving_kg":    mass_saving_kg,
        "mass_saving_pct":   mass_saving_pct,
        "cost_saving_usd":   cost_saving_usd,
        "cu_saving_per_kwh": cu_saving_per_kwh,
        "co2_per_cell":      co2_per_cell,
        "co2_per_kwh":       co2_per_kwh,
    }

