def pct(v, total):
    """Return v as a percentage of total, formatted to 1 decimal place."""
    return f"{v / total * 100:.1f}%"

def run_electrochemical(c_cap, c_volt, c_dens, c_am, c_carb, c_bind, c_por, c_thick,
                        a_cap, a_volt, a_dens, a_am, a_bind, a_carb, a_por,
                        np_ratio, electrode_area_cm2, tab_excess):

    # 1. Cell average voltage (V)
    cell_voltage = c_volt - a_volt

    # 2. Cathode areal capacity (mAh/cm²)
    c_areal = (c_thick / 10000) * c_dens * c_am * (1 - c_por) * c_cap

    # 3. Cell capacity derived from electrode area and cathode areal capacity (Ah)
    # This is the true bottom-up direction: area → capacity
    electrode_area = electrode_area_cm2
    cell_capacity = c_areal * electrode_area / 1000

    # 4. Target anode areal capacity - adjusted for tab excess (mAh/cm²)
    # Anode covers larger area by (1 + tab_excess), so each cm² needs less charge
    a_areal_target = c_areal * np_ratio / (1 + tab_excess)

    # 5. Anode thickness - solved from target areal capacity (µm)
    # Rearrangement of areal capacity equation solving for thickness
    a_thick = (a_areal_target / (a_dens * a_am * (1 - a_por) * a_cap)) * 10000

    # 6. Actual anode areal capacity - recalculated from derived thickness for validation
    a_areal = (a_thick / 10000) * a_dens * a_am * (1 - a_por) * a_cap

    # 7. Cathode material masses (g/cell)
    c_AM_mass     = cell_capacity / c_cap * 1000     # active material
    c_coat_total  = c_AM_mass / c_am                 # total coating = AM / AM fraction
    c_carbon_mass = c_coat_total * c_carb            # carbon additive
    c_binder_mass = c_coat_total * c_bind            # binder

    # 8. Anode material masses (g/cell)
    # Scaled by N/P ratio (extra capacity buffer) and tab excess (larger physical area)
    a_AM_mass     = cell_capacity / a_cap * 1000 * np_ratio * (1 + tab_excess)
    a_coat_total  = a_AM_mass / a_am
    a_binder_mass = a_coat_total * a_bind
    a_carbon_mass = a_coat_total * a_carb

    # 9. Validation quantities
    np_actual  = (a_areal * (1 + tab_excess)) / c_areal
    c_frac_sum = c_am + c_carb + c_bind
    a_frac_sum = a_am + a_bind + a_carb

    return {
        "cell_voltage":   cell_voltage,
        "c_areal":        c_areal,
        "electrode_area": electrode_area,
        "cell_capacity":  cell_capacity,
        "a_areal_target": a_areal_target,
        "a_thick":        a_thick,
        "a_areal":        a_areal,
        "c_AM_mass":      c_AM_mass,
        "c_coat_total":   c_coat_total,
        "c_carbon_mass":  c_carbon_mass,
        "c_binder_mass":  c_binder_mass,
        "a_AM_mass":      a_AM_mass,
        "a_coat_total":   a_coat_total,
        "a_binder_mass":  a_binder_mass,
        "a_carbon_mass":  a_carbon_mass,
        "np_actual":      np_actual,
        "c_frac_sum":     c_frac_sum,
        "a_frac_sum":     a_frac_sum,
        "voltage_ok":     2.5 <= cell_voltage <= 4.5,
        "np_ok":          np_actual >= np_ratio - 0.003,
        "c_frac_ok":      abs(c_frac_sum - 1.0) <= 0.01,
        "a_frac_ok":      abs(a_frac_sum - 1.0) <= 0.01,
    }
    
def run_cell_design(
    cathode_thickness_um, anode_thickness_um, electrode_area_cm2,
    cell_capacity_Ah, cell_voltage_V,
    cathode_bulk_density, anode_bulk_density,
    cathode_porosity, anode_porosity,
    cathode_coating_total_g, anode_coating_total_g,
    num_layers_input, length_to_width_ratio,
    sep_excess_width_mm, sep_excess_length_mm,
    tab_length_mm, feedthrough_mm,
    container_thickness_um, container_density,
    wall_thickness_mm, seal_buffer_mm,
    cathode_foil_thickness_um, anode_foil_thickness_um, al_density,
    sep_thickness_um, sep_density,
    electrolyte_density, electrolyte_uptake_frac,
    terminal_mass_cathode_g, terminal_mass_anode_g,
    tab_excess):

    # ── Unit conversions (all to cm) ──────────────────────────────────────
    c_thick_cm   = cathode_thickness_um   / 10000
    a_thick_cm   = anode_thickness_um     / 10000
    sep_thick_cm = sep_thickness_um       / 10000
    con_thick_cm = container_thickness_um / 10000
    c_foil_cm    = cathode_foil_thickness_um / 10000
    a_foil_cm    = anode_foil_thickness_um   / 10000
    wall_cm       = wall_thickness_mm / 10
    seal_cm       = seal_buffer_mm    / 10
    tab_ext_cm    = tab_length_mm     / 10
    feedthrough_cm = feedthrough_mm   / 10
    sep_excess_w_cm = sep_excess_width_mm  / 10
    sep_excess_l_cm = sep_excess_length_mm / 10

    # 1. Number of bicell layers
    # One bicell = cathode coating + cathode foil + separator + anode foil + anode coating + separator
    # 0.97 packing efficiency accounts for imperfect stacking
    bicell_thickness_cm    = c_thick_cm + a_thick_cm + 2 * sep_thick_cm + c_foil_cm + a_foil_cm
    num_bicell_layers      = num_layers_input
    available_thickness_cm = num_bicell_layers * bicell_thickness_cm / 0.97
    cell_thick_cm          = available_thickness_cm + 2 * con_thick_cm

    # 2. Electrode width and length from area and aspect ratio
    # Total electrode area = num_layers × 2 faces × width × length
    # length = width × ratio  →  area = num_layers × 2 × width² × ratio
    area_per_face_cm2  = electrode_area_cm2 / (num_bicell_layers * 2)
    electrode_width_cm = (area_per_face_cm2 / length_to_width_ratio) ** 0.5
    electrode_length_cm = electrode_width_cm * length_to_width_ratio

    # 3. Internal tab lengths (portion inside the cell)
    cathode_tab_cm = 1.2 * cell_thick_cm
    anode_tab_cm   = cathode_tab_cm - 0.5 * sep_excess_w_cm

    # 4. Cell external dimensions
    # Width: electrode + separator excess + 2× wall + 2× seal buffer
    # Length: electrode + 2× (external tab + feedthrough)
    cell_width_mm  = (electrode_width_cm + sep_excess_w_cm + 2 * wall_cm + 2 * seal_cm) * 10
    cell_length_mm = (electrode_length_cm + 2 * (tab_ext_cm + feedthrough_cm)) * 10
    cell_volume_cm3 = cell_thick_cm * (cell_width_mm / 10) * (cell_length_mm / 10)

    # 5. Cathode foil area (m²)
    # num_layers × width × (length + internal tab)
    cathode_foil_area_m2 = num_bicell_layers * (electrode_width_cm / 100) * ((electrode_length_cm + cathode_tab_cm) / 100)

    # 6. Anode foil area (m²)
    # Anode is slightly wider (sep excess overhang) and has (layers + 1) sheets
    anode_excess_cm     = sep_excess_w_cm
    anode_foil_area_m2  = (num_bicell_layers + 1) * ((electrode_width_cm + anode_excess_cm) / 100) * ((electrode_length_cm + anode_tab_cm + anode_excess_cm) / 100)

    # 7. Separator area (m²)
    # 2 separators per bicell × (electrode + excess) on each dimension
    sep_area_m2 = 2 * num_bicell_layers * ((electrode_width_cm + sep_excess_w_cm) / 100) * ((electrode_length_cm + sep_excess_l_cm) / 100)

    # 8. Foil masses (g)
    # mass = area_cm² × thickness_cm × density
    cathode_foil_mass_g = cathode_foil_area_m2 * 10000 * c_foil_cm * al_density
    anode_foil_mass_g   = anode_foil_area_m2   * 10000 * a_foil_cm * al_density

    # 9. Separator mass (g)
    sep_mass_g = sep_area_m2 * 10000 * sep_thick_cm * sep_density

    # 10. Electrolyte volume (cm³) and mass (g)
    # Fills void space in cathode, anode, and separator, plus 2% of cell volume as excess
    cathode_void_cm3 = (cathode_coating_total_g / cathode_bulk_density) * cathode_porosity
    anode_void_cm3   = (anode_coating_total_g   / anode_bulk_density)   * anode_porosity
    sep_void_cm3     = sep_area_m2 * 10000 * sep_thick_cm * electrolyte_uptake_frac
    extra_vol_cm3    = cell_thick_cm * (cell_width_mm / 10) * (cell_length_mm / 10) * 0.02
    elec_vol_cm3     = cathode_void_cm3 + anode_void_cm3 + sep_void_cm3 + extra_vol_cm3
    elec_vol_L       = elec_vol_cm3 / 1000
    elec_mass_g      = elec_vol_L * electrolyte_density * 1000

    # 11. Container mass (g)
    # Pouch: 2 identical laminate faces
    # Prismatic: 6-face aluminium box
    if wall_thickness_mm > 0:
        # Prismatic - 6-face box
        w = cell_width_mm  / 10
        l = cell_length_mm / 10
        t = cell_thick_cm
        container_area_cm2 = 2 * (w * l + w * t + l * t)
        container_mass_g   = container_area_cm2 * con_thick_cm * container_density
    else:
        # Pouch - 2 laminate faces
        face_area_cm2    = (cell_width_mm / 10) * (cell_length_mm / 10)
        container_mass_g = 2 * face_area_cm2 * con_thick_cm * container_density

    # 12. Total cell mass (g)
    cell_mass_g = (
        cathode_coating_total_g + anode_coating_total_g
        + cathode_foil_mass_g     + anode_foil_mass_g
        + sep_mass_g              + elec_mass_g
        + terminal_mass_cathode_g + terminal_mass_anode_g
        + container_mass_g
    )

    # 13. Cell energy (Wh)
    cell_energy_Wh = cell_capacity_Ah * cell_voltage_V

    # 14. Specific energy (Wh/kg)
    cell_specific_energy = cell_energy_Wh / (cell_mass_g / 1000)

    # 15. Energy density (Wh/L)
    cell_energy_density = cell_energy_Wh / (cell_volume_cm3 / 1000)

    # Validation
    cell_thick_ok = available_thickness_cm > bicell_thickness_cm
    layers_ok     = num_bicell_layers >= 3
    area_ok       = electrode_area_cm2 > 0

    return {
        "num_bicell_layers":        num_bicell_layers,
        "cell_thickness_mm":        cell_thick_cm * 10,
        "electrode_width_mm":       electrode_width_cm  * 10,
        "electrode_length_mm":      electrode_length_cm * 10,
        "cell_width_mm":            cell_width_mm,
        "cell_length_mm":           cell_length_mm,
        "cell_volume_cm3":          cell_volume_cm3,
        "cathode_foil_area_m2":     cathode_foil_area_m2,
        "anode_foil_area_m2":       anode_foil_area_m2,
        "sep_area_m2":              sep_area_m2,
        "cathode_foil_mass_g":      cathode_foil_mass_g,
        "anode_foil_mass_g":        anode_foil_mass_g,
        "sep_mass_g":               sep_mass_g,
        "cathode_void_cm3":         cathode_void_cm3,
        "anode_void_cm3":           anode_void_cm3,
        "sep_void_cm3":             sep_void_cm3,
        "extra_vol_cm3":            extra_vol_cm3,
        "elec_vol_cm3":             elec_vol_cm3,
        "elec_vol_L":               elec_vol_L,
        "elec_mass_g":              elec_mass_g,
        "container_mass_g":         container_mass_g,
        "cell_mass_g":              cell_mass_g,
        "cell_energy_Wh":           cell_energy_Wh,
        "cell_specific_energy":     cell_specific_energy,
        "cell_energy_density":      cell_energy_density,
        "bicell_thickness_cm":      bicell_thickness_cm,
        "available_thickness_cm":   available_thickness_cm,
        "cell_thick_ok":            cell_thick_ok,
        "layers_ok":                layers_ok,
        "area_ok":                  area_ok,
    }

def run_pack_design(
    cell_mass_g, cell_energy_Wh, cell_volume_cm3,
    cell_voltage_V, cell_capacity_Ah,
    cells_series, cells_parallel,
    useable_soc_fraction,
    bms_mass_kg, thermal_mass_kg, structure_mass_kg,
    bms_volume_L, thermal_volume_L, structure_volume_L):

    # 1. Total cells in pack
    total_cells = cells_series * cells_parallel

    # 2. Pack nominal voltage (V)
    pack_voltage_V = cells_series * cell_voltage_V

    # 3. Pack total capacity (Ah) - parallel cells sum capacity
    pack_capacity_Ah = cells_parallel * cell_capacity_Ah

    # 4. Pack gross energy (kWh) - all cells at full charge
    pack_gross_energy_kWh = (pack_voltage_V * pack_capacity_Ah) / 1000

    # 5. Pack useable energy (kWh) - derated by useable SOC window
    pack_useable_energy_kWh = pack_gross_energy_kWh * useable_soc_fraction

    # 6. Cell mass total (kg)
    cell_mass_total_kg = total_cells * cell_mass_g / 1000

    # 7. Non-cell mass (kg)
    non_cell_mass_kg = bms_mass_kg + thermal_mass_kg + structure_mass_kg

    # 8. Total pack mass (kg)
    pack_mass_kg = cell_mass_total_kg + non_cell_mass_kg

    # 9. Pack gravimetric energy density (Wh/kg) - based on useable energy
    pack_specific_energy = (pack_useable_energy_kWh * 1000) / pack_mass_kg

    # 10. Cell volume total (L)
    cell_volume_total_L = total_cells * cell_volume_cm3 / 1000

    # 11. Non-cell volume (L)
    non_cell_volume_L = bms_volume_L + thermal_volume_L + structure_volume_L

    # 12. Total pack volume (L)
    pack_volume_L = cell_volume_total_L + non_cell_volume_L

    # 13. Pack volumetric energy density (Wh/L)
    pack_energy_density = (pack_useable_energy_kWh * 1000) / pack_volume_L

    # 14. Cell mass fraction (how much of pack mass is cells)
    cell_mass_fraction = cell_mass_total_kg / pack_mass_kg

    # 15. Cell volume fraction
    cell_volume_fraction = cell_volume_total_L / pack_volume_L

    return {
        "total_cells":               total_cells,
        "pack_voltage_V":            pack_voltage_V,
        "pack_capacity_Ah":          pack_capacity_Ah,
        "pack_gross_energy_kWh":     pack_gross_energy_kWh,
        "pack_useable_energy_kWh":   pack_useable_energy_kWh,
        "cell_mass_total_kg":        cell_mass_total_kg,
        "non_cell_mass_kg":          non_cell_mass_kg,
        "pack_mass_kg":              pack_mass_kg,
        "pack_specific_energy":      pack_specific_energy,
        "cell_volume_total_L":       cell_volume_total_L,
        "non_cell_volume_L":         non_cell_volume_L,
        "pack_volume_L":             pack_volume_L,
        "pack_energy_density":       pack_energy_density,
        "cell_mass_fraction":        cell_mass_fraction,
        "cell_volume_fraction":      cell_volume_fraction,
    }

def run_cost_model(
    # Material quantities from upstream modules
    c_AM_mass_g, a_AM_mass_g,
    c_carbon_g, a_carbon_g,
    c_binder_g, a_binder_g,
    c_foil_m2, a_foil_m2,
    sep_m2, elec_vol_L,
    container_mass_g, terminal_mass_g,
    # Material prices
    p_cathode_am, p_anode_am, p_carbon,
    p_pvdf, p_cmcsbr, p_al_foil,
    p_sep, p_electrolyte, p_container, p_terminal,
    # Manufacturing and pack overhead
    p_manufacturing,
    pack_overhead_cost,
    # Pack scale
    total_cells, pack_useable_energy_kWh,
    # LFP benchmark
    lfp_benchmark_per_kwh):

    # 1. Individual material costs per cell ($/cell)
    cost_cathode_am  = c_AM_mass_g  / 1000 * p_cathode_am
    cost_anode_am    = a_AM_mass_g  / 1000 * p_anode_am
    cost_carbon      = (c_carbon_g + a_carbon_g) / 1000 * p_carbon
    cost_pvdf        = c_binder_g   / 1000 * p_pvdf
    cost_cmcsbr      = a_binder_g   / 1000 * p_cmcsbr
    cost_c_foil      = c_foil_m2    * p_al_foil
    cost_a_foil      = a_foil_m2    * p_al_foil
    cost_sep         = sep_m2       * p_sep
    cost_elec        = elec_vol_L   * p_electrolyte
    cost_container   = container_mass_g / 1000 * p_container
    cost_terminal    = p_terminal

    # 2. Total material cost per cell
    mat_cost_per_cell = (
        cost_cathode_am + cost_anode_am + cost_carbon
        + cost_pvdf + cost_cmcsbr + cost_c_foil + cost_a_foil
        + cost_sep + cost_elec + cost_container + cost_terminal
    )

    # 3. Total cell cost (material + manufacturing)
    cell_cost = mat_cost_per_cell + p_manufacturing

    # 4. Total pack cost
    pack_cell_cost  = cell_cost * total_cells
    pack_total_cost = pack_cell_cost + pack_overhead_cost

    # 5. Cost per kWh (key output)
    cost_per_kwh = pack_total_cost / pack_useable_energy_kWh

    # 6. Gap vs LFP benchmark
    gap_vs_lfp = cost_per_kwh - lfp_benchmark_per_kwh
    gap_pct    = (gap_vs_lfp / lfp_benchmark_per_kwh) * 100

    return {
        "cost_cathode_am":   cost_cathode_am,
        "cost_anode_am":     cost_anode_am,
        "cost_carbon":       cost_carbon,
        "cost_pvdf":         cost_pvdf,
        "cost_cmcsbr":       cost_cmcsbr,
        "cost_c_foil":       cost_c_foil,
        "cost_a_foil":       cost_c_foil,
        "cost_sep":          cost_sep,
        "cost_elec":         cost_elec,
        "cost_container":    cost_container,
        "cost_terminal":     cost_terminal,
        "mat_cost_per_cell": mat_cost_per_cell,
        "p_manufacturing":   p_manufacturing,
        "cell_cost":         cell_cost,
        "pack_cell_cost":    pack_cell_cost,
        "pack_overhead_cost":pack_overhead_cost,
        "pack_total_cost":   pack_total_cost,
        "cost_per_kwh":      cost_per_kwh,
        "gap_vs_lfp":        gap_vs_lfp,
        "gap_pct":           gap_pct,
        "mat_frac":          mat_cost_per_cell / cell_cost,
        "mfg_frac":          p_manufacturing   / cell_cost,
    }

def run_sustainability(
    # Per-cell masses from upstream
    c_AM_mass_g, a_AM_mass_g,
    c_carbon_g, a_carbon_g,
    c_binder_g, a_binder_g,
    c_foil_area_m2, a_foil_area_m2,
    sep_area_m2, elec_mass_g,
    container_mass_g, cell_mass_g,
    # Foil geometry
    a_foil_thick_um,
    # Pack scale
    total_cells, pack_useable_energy_kWh,
    # Cu/Al comparison prices
    p_al_kg, p_cu_kg,
    # CO2 intensity factors (kgCO2/kg)
    co2_cathode_am, co2_anode_am, co2_al_foil,
    co2_separator, co2_electrolyte, co2_carbon, co2_pvdf):

    AL_DENSITY = 2.70
    CU_DENSITY = 8.96

    # 1. Material intensity per kWh (kg material / kWh useable)
    def intensity(mass_g_per_cell):
        return (mass_g_per_cell * total_cells / 1000) / pack_useable_energy_kWh

    int_cathode_am  = intensity(c_AM_mass_g)
    int_anode_am    = intensity(a_AM_mass_g)
    int_carbon      = intensity(c_carbon_g + a_carbon_g)
    int_binder      = intensity(c_binder_g + a_binder_g)
    int_electrolyte = intensity(elec_mass_g)
    int_cell_total  = intensity(cell_mass_g)

    # 2. Al vs Cu foil comparison
    # Al anode foil actual mass (g/cell)
    al_anode_g = a_foil_area_m2 * 10000 * (a_foil_thick_um / 10000) * AL_DENSITY
    # Cu equivalent - same geometry, Cu density
    cu_equiv_g = a_foil_area_m2 * 10000 * (a_foil_thick_um / 10000) * CU_DENSITY

    al_pack_kg = al_anode_g * total_cells / 1000
    cu_pack_kg = cu_equiv_g * total_cells / 1000
    mass_saving_kg = cu_pack_kg - al_pack_kg
    cost_saving_usd = cu_pack_kg * p_cu_kg - al_pack_kg * p_al_kg
    cu_saving_per_kwh = cost_saving_usd / pack_useable_energy_kWh
    mass_saving_pct = (mass_saving_kg / cu_pack_kg) * 100

    # 3. CO2 intensity (kgCO2/kWh) - indicative
    al_foil_mass_g = (c_foil_area_m2 + a_foil_area_m2) * 10000 * (a_foil_thick_um / 10000) * AL_DENSITY
    sep_mass_g = sep_area_m2 * 10000 * 0.002 * 0.92  # approx from 20um PE

    co2_per_cell = (
        c_AM_mass_g    / 1000 * co2_cathode_am  +
        a_AM_mass_g    / 1000 * co2_anode_am    +
        al_foil_mass_g / 1000 * co2_al_foil     +
        sep_mass_g     / 1000 * co2_separator   +
        elec_mass_g    / 1000 * co2_electrolyte +
        (c_carbon_g + a_carbon_g) / 1000 * co2_carbon +
        c_binder_g     / 1000 * co2_pvdf
    )
    co2_per_kwh = (co2_per_cell * total_cells) / pack_useable_energy_kWh

    return {
        "int_cathode_am":    int_cathode_am,
        "int_anode_am":      int_anode_am,
        "int_carbon":        int_carbon,
        "int_binder":        int_binder,
        "int_electrolyte":   int_electrolyte,
        "int_cell_total":    int_cell_total,
        "al_pack_kg":        al_pack_kg,
        "cu_pack_kg":        cu_pack_kg,
        "mass_saving_kg":    mass_saving_kg,
        "mass_saving_pct":   mass_saving_pct,
        "cost_saving_usd":   cost_saving_usd,
        "cu_saving_per_kwh": cu_saving_per_kwh,
        "co2_per_cell":      co2_per_cell,
        "co2_per_kwh":       co2_per_kwh,
    }

def generate_study_pdf(study_name, e, c, p, r4, r5):
    buffer = io.BytesIO()
    doc = SimpleDocTemplate(
        buffer, pagesize=A4,
        leftMargin=20*mm, rightMargin=20*mm,
        topMargin=20*mm, bottomMargin=20*mm
    )

    W = colors.HexColor("#d97706")
    BG = colors.HexColor("#f5f5f0")
    DK = colors.HexColor("#0a0e1a")
    GR = colors.HexColor("#7E7E7E")

    styles = getSampleStyleSheet()
    title_style = ParagraphStyle("title", fontSize=22, textColor=DK, fontName="Helvetica-Bold", spaceAfter=2*mm)
    sub_style   = ParagraphStyle("sub",   fontSize=9,  textColor=GR, fontName="Helvetica",     spaceAfter=6*mm)
    h1_style    = ParagraphStyle("h1",    fontSize=10, textColor=W,  fontName="Helvetica-Bold", spaceBefore=6*mm, spaceAfter=2*mm)
    body_style  = ParagraphStyle("body",  fontSize=8.5, textColor=DK, fontName="Helvetica",    spaceAfter=1*mm)

    def section(title):
        return [
            HRFlowable(width="100%", thickness=0.5, color=W, spaceAfter=1*mm),
            Paragraph(title.upper(), h1_style),
        ]

    def row_table(data, col_widths=None):
        if col_widths is None:
            col_widths = [90*mm, 55*mm, 30*mm]
        t = Table(data, colWidths=col_widths)
        t.setStyle(TableStyle([
            ("FONTNAME",    (0,0), (-1,-1), "Helvetica"),
            ("FONTSIZE",    (0,0), (-1,-1), 8),
            ("TEXTCOLOR",   (0,0), (0,-1), GR),
            ("TEXTCOLOR",   (1,0), (-1,-1), DK),
            ("FONTNAME",    (1,0), (-1,-1), "Helvetica-Bold"),
            ("ROWBACKGROUNDS", (0,0), (-1,-1), [colors.white, colors.HexColor("#f9f9f6")]),
            ("TOPPADDING",  (0,0), (-1,-1), 2),
            ("BOTTOMPADDING",(0,0),(-1,-1), 2),
            ("LEFTPADDING", (0,0), (-1,-1), 3),
        ]))
        return t

    from datetime import datetime
    story = []

    # Header
    story.append(Paragraph(f"SIB Techno-Economic Model", sub_style))
    story.append(Paragraph(study_name or "Study Summary", title_style))
    story.append(Paragraph(f"Generated {datetime.now().strftime('%d %B %Y, %H:%M')}  ·  Imperial College London", sub_style))

    # Module 01 inputs
    story += section("Module 01 - Electrochemical Design (Inputs)")
    story.append(row_table([
        ["Electrode area (input)",       f"{e.get('electrode_area', 0):.0f} cm²",        ""],
        ["Cathode thickness",            f"{e.get('cathode_thickness', 0):.1f} µm",       "Design variable"],
        ["N/P capacity ratio",           f"{e.get('np_actual', 0):.3f}",                  ""],
        ["Cathode bulk density",         f"{e.get('cathode_bulk_density', 0):.2f} g/cm³", ""],
        ["Anode bulk density",           f"{e.get('anode_bulk_density', 0):.2f} g/cm³",   ""],
        ["Cathode porosity",             f"{e.get('cathode_porosity', 0):.2f}",           ""],
        ["Anode porosity",               f"{e.get('anode_porosity', 0):.2f}",             ""],
    ]))

    # Module 01 outputs
    story += section("Module 01 - Electrochemical Design (Outputs)")
    story.append(row_table([
        ["Cell capacity",                f"{e.get('cell_capacity', 0):.2f} Ah",           "Derived from area"],
        ["Cell average voltage",         f"{e.get('cell_voltage', 0):.3f} V",             ""],
        ["Cathode areal capacity",       f"{e.get('c_areal', 0):.3f} mAh/cm²",           ""],
        ["Anode thickness",              f"{e.get('a_thick', 0):.1f} µm",                 "Derived"],
        ["Cathode AM mass",              f"{e.get('c_AM_mass', 0):.2f} g/cell",           ""],
        ["Anode AM mass",                f"{e.get('a_AM_mass', 0):.2f} g/cell",           ""],
    ]))

    # Module 02 outputs
    story += section("Module 02 - Cell Design (Outputs)")
    story.append(row_table([
        ["Cell mass",                    f"{c.get('cell_mass_g', 0):.1f} g",              ""],
        ["Cell energy",                  f"{c.get('cell_energy_Wh', 0):.1f} Wh",         ""],
        ["Specific energy",              f"{c.get('cell_specific_energy', 0):.1f} Wh/kg", ""],
        ["Energy density",               f"{c.get('cell_energy_density', 0):.1f} Wh/L",  ""],
        ["Cell thickness",               f"{c.get('cell_thickness_mm', 0):.1f} mm",       "Derived"],
        ["Cell width × length",          f"{c.get('cell_width_mm',0):.1f} × {c.get('cell_length_mm',0):.1f} mm", ""],
        ["Bicell layers",                f"{c.get('num_bicell_layers', 0)}",              ""],
        ["Separator area",               f"{c.get('sep_area_m2', 0):.4f} m²",            ""],
        ["Electrolyte volume",           f"{c.get('elec_vol_L', 0):.4f} L",              ""],
    ]))

    # Module 03 outputs
    story += section("Module 03 - Pack Design (Outputs)")
    story.append(row_table([
        ["Pack configuration",           f"{p.get('cells_series', 0)}S × {p.get('cells_parallel', 0)}P = {p.get('total_cells', 0)} cells", ""],
        ["Pack voltage",                 f"{p.get('pack_voltage_V', 0):.1f} V",           ""],
